{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 tools/package.py:*)",
      "Bash(python3 tools/smoke_scaffold.py:*)",
      "Bash(python3 .claude/skills/update-watch/scripts/fetch.py:*)",
      "Bash(claude plugin validate:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(claude plugin tag:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-claude-version.sh\""
          }
        ]
      }
    ]
  }
}
